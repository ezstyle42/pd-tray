{
  "name": "pd-tray-sync",
  "productName": "Proton Drive Tray Sync",
  "version": "0.1.0",
  "description": "Unofficial Proton Drive folder sync app with a system tray icon (Linux, Mint/Cinnamon friendly).",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "dev": "node scripts/build-main.mjs && vite build --watch & electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "electron-builder --linux",
    "dist": "npm run build && electron-builder --linux AppImage",
    "postinstall": "node scripts/apply-crypto-patch.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@protontech/crypto": "2.0.0",
    "@protontech/drive-sdk": "^0.22.2",
    "chokidar": "^3.6.0",
    "ky": "^1.14.3"
  },
  "devDependencies": {
    "@protontech/global-types": "^1.1.0",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "io.github.ezstyle42.pdtraysync",
    "productName": "Proton Drive Tray Sync",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "synopsis": "Unofficial Proton Drive folder sync"
    },
    "files": [
      "dist/**",
      "renderer/dist/**",
      "build/icon*",
      "node_modules/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "directories": {
      "output": "out"
    }
  },
  "overrides": {
    "@openpgp/web-stream-tools": "0.1.3",
    "openpgp": "npm:@protontech/openpgp@6.3.1-0"
  }
}
